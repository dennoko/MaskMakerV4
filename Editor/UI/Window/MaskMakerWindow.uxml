<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements">
    <!-- P4 シーン作業（skill blocks/patterns.md）。状態は Idle（未開始）と Working（作業中）の 2 つだけ。
         Idle: B1 対象カードと主ボタン「作業開始」だけ。Working: B7 バナー + B1 + B3 UV ビュー + B5 出力カード、主ボタン「出力」。
         文言は C# が L10n から入れる（ここの text は見本） -->

    <!-- ───────── 標準ヘッダー（トップバー） ───────── -->
    <ui:VisualElement name="appbar" class="dennoko-appbar">
        <ui:VisualElement class="dennoko-appbar__title">
            <ui:Label name="appbar-title" text="MaskMaker V4" class="dennoko-title" />
            <ui:Label name="version-label" text="" class="dennoko-version-label" />
            <ui:Button name="version-reload-button" class="dennoko-icon-button" />
        </ui:VisualElement>
        <ui:VisualElement class="dennoko-appbar__actions">
            <ui:Button name="appbar-lang" text="EN" class="dennoko-appbar-lang" />
            <ui:Button name="appbar-manual" class="dennoko-icon-button" />
            <ui:Button name="appbar-settings" class="dennoko-icon-button" />
        </ui:VisualElement>
    </ui:VisualElement>

    <!-- ───────── B7 作業中バナー（Working のみ。スクロール領域の外） ───────── -->
    <ui:VisualElement name="session-banner" class="dennoko-session-banner">
        <ui:VisualElement class="dennoko-session-dot" />
        <ui:Label name="session-state" text="作業中" class="dennoko-session-banner__state" />
        <ui:Label name="session-target" text="" class="dennoko-session-banner__target" />
        <ui:VisualElement class="dennoko-session-banner__hint">
            <ui:Label text="Esc" class="dennoko-keycap" />
            <ui:Label name="session-hint" text="で終了" class="dennoko-keyhint-label" style="margin-right: 0;" />
        </ui:VisualElement>
        <ui:Button name="session-end" text="終了" class="dennoko-button-secondary" />
    </ui:VisualElement>

    <ui:ScrollView name="main-scroll" class="dennoko-scroll">

        <!-- B1 対象カード -->
        <ui:VisualElement name="target-card" class="dennoko-card dennoko-target-card">
            <ui:VisualElement class="dennoko-card-header dennoko-card-header--row">
                <ui:Label name="target-header" text="ターゲットメッシュ" class="dennoko-section-title dennoko-card-header__title" />
            </ui:VisualElement>
            <!-- Idle: 対象を選ぶ行（Hierarchy の選択に追従して自動で入る） -->
            <ui:VisualElement name="target-idle" class="dennoko-target-row">
                <uie:ObjectField name="target-field" type="UnityEngine.Renderer, UnityEngine.CoreModule" allow-scene-objects="true" />
            </ui:VisualElement>
            <!-- 候補が複数（ルートを選んだとき）。クリックで決定、ダブルクリックで開始 -->
            <ui:VisualElement name="target-candidates" class="dennoko-candidates" />
            <!-- Working: アイコン + 名前 ▼（▼ で同じアバター内の対象に切り替え） -->
            <ui:VisualElement name="target-working" class="dennoko-target-row">
                <ui:Button name="target-switch" class="dennoko-target-working">
                    <ui:VisualElement name="target-switch-icon" class="dennoko-icon" />
                    <ui:Label name="target-switch-name" text="" class="dennoko-target-working__name" />
                    <ui:Label text="▼" class="dennoko-target-working__arrow" />
                </ui:Button>
            </ui:VisualElement>
            <ui:VisualElement name="target-sub" class="dennoko-target-sub">
                <ui:DropdownField name="target-submesh" />
                <ui:DropdownField name="target-uv" />
            </ui:VisualElement>
            <ui:VisualElement name="target-info" class="dennoko-info-row" />
        </ui:VisualElement>

        <!-- B3 プレビューカード（UV ビュー。見出しなし。Working のみ） -->
        <ui:VisualElement name="uv-card" class="dennoko-card dennoko-preview-card">
            <ui:VisualElement name="uv-host" class="dennoko-preview mm-uv-host">
                <ui:VisualElement class="dennoko-preview__toolbar">
                    <ui:Button name="reset-view-button" class="dennoko-icon-button" />
                    <ui:Button name="base-overlay-button" class="dennoko-icon-button" />
                    <ui:Button name="layout-button" class="dennoko-icon-button" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:Slider name="base-alpha-slider" low-value="0" high-value="1" show-input-field="true" class="mm-base-alpha" />
            <ui:VisualElement class="dennoko-info-row">
                <ui:Label name="uv-info" text="" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- B5 出力カード（出力設定が 3 行以上なのでカード。ドックには要約チップだけ。Working のみ） -->
        <ui:VisualElement name="output-card" class="dennoko-card dennoko-output-card">
            <ui:VisualElement class="dennoko-card-header dennoko-card-header--row">
                <ui:Label name="output-header" text="出力" class="dennoko-section-title dennoko-card-header__title" />
            </ui:VisualElement>
            <ui:VisualElement class="dennoko-hrow">
                <ui:TextField name="file-name" class="dennoko-col-grow" />
                <ui:Label text=".png" class="dennoko-text-tertiary mm-ext" />
            </ui:VisualElement>
            <ui:VisualElement class="dennoko-field-row">
                <ui:Label name="size-label" text="解像度" class="dennoko-field-row__label" />
                <ui:VisualElement name="size-group" class="dennoko-segmented dennoko-choice-group">
                    <ui:Button name="size-512" text="512" />
                    <ui:Button name="size-1024" text="1024" />
                    <ui:Button name="size-2048" text="2048" />
                    <ui:Button name="size-4096" text="4096" />
                </ui:VisualElement>
                <ui:Label name="size-locked" text="" class="dennoko-text-tertiary mm-size-locked" />
            </ui:VisualElement>
            <ui:Toggle name="channel-toggle" text="チャンネル" />
            <ui:VisualElement name="channel-group" class="mm-indent">
                <ui:VisualElement class="dennoko-segmented dennoko-choice-group mm-channels">
                    <ui:Button name="ch-r" text="R" />
                    <ui:Button name="ch-g" text="G" />
                    <ui:Button name="ch-b" text="B" />
                    <ui:Button name="ch-a" text="A" />
                </ui:VisualElement>
                <uie:ObjectField name="base-png" type="UnityEngine.Texture2D, UnityEngine.CoreModule" allow-scene-objects="false" />
            </ui:VisualElement>

            <!-- 詳細（閉じた状態が既定。閉じている間は見出し行に要約チップ） -->
            <ui:VisualElement name="output-details" class="dennoko-details dennoko-details--collapsed">
                <ui:VisualElement class="dennoko-details__header">
                    <ui:Label text="▶" class="dennoko-details__arrow" />
                    <ui:Label name="output-details-title" text="詳細" class="dennoko-details__title" />
                    <ui:VisualElement name="output-details-chips" class="dennoko-details__chips" />
                </ui:VisualElement>
                <ui:VisualElement class="dennoko-details__content">
                    <ui:VisualElement class="dennoko-hrow">
                        <ui:Toggle name="invert-toggle" text="反転" class="dennoko-col-grow" />
                        <ui:VisualElement name="invert-dot" class="mm-override-dot" />
                    </ui:VisualElement>
                    <ui:VisualElement class="dennoko-hrow">
                        <ui:SliderInt name="margin-slider" label="余白" low-value="0" high-value="32" show-input-field="true" class="dennoko-col-grow" />
                        <ui:VisualElement name="margin-dot" class="mm-override-dot" />
                    </ui:VisualElement>
                    <ui:VisualElement class="dennoko-hrow">
                        <ui:Toggle name="save-inverted-toggle" text="反転も保存" class="dennoko-col-grow" />
                        <ui:VisualElement name="save-inverted-dot" class="mm-override-dot" />
                    </ui:VisualElement>
                    <ui:Label name="inverted-preview" text="" class="dennoko-hint mm-indent" />
                    <ui:VisualElement class="dennoko-hrow">
                        <ui:Toggle name="mask-subfolder-toggle" text="Mask/ に保存" class="dennoko-col-grow" />
                        <ui:VisualElement name="mask-subfolder-dot" class="mm-override-dot" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

    </ui:ScrollView>

    <!-- ───────── 出力ドック（要約チップだけ。出力カードが見えている間は隠す。Working のみ） ───────── -->
    <ui:VisualElement name="output-dock" class="dennoko-output">
        <ui:VisualElement class="dennoko-output-row">
            <ui:VisualElement name="output-dock-chips" class="dennoko-output__chips" />
        </ui:VisualElement>
    </ui:VisualElement>

    <!-- ───────── フッター（Idle = 作業開始 / Working = 出力。主ボタンは 1 つ） ───────── -->
    <ui:VisualElement name="footer" class="dennoko-footer">
        <ui:Button name="primary-button" text="作業開始" class="dennoko-button-primary" />
    </ui:VisualElement>

    <!-- ステータス（Label に子要素を足さない。操作ボタンは横に並べる） -->
    <ui:VisualElement class="mm-status-row">
        <ui:Label name="status-label" text="" class="dennoko-status" />
        <ui:Button name="status-action" text="" class="dennoko-button-secondary mm-status-action" />
    </ui:VisualElement>

</ui:UXML>
